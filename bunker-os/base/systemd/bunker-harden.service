[Unit]
Description=Bunker OS Hardening Service
Documentation=man:bunker(8)
After=bunker-core.service
Requires=bunker-core.service

[Service]
Type=oneshot
ExecStart=/usr/lib/bunker/services/harden.sh start
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/bunker /var/log/bunker

[Install]
WantedBy=multi-user.target